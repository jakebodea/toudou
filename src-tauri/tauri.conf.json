{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "toudou",
  "version": "0.1.1",
  "identifier": "dev.toudou.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "toudou",
        "width": 420,
        "height": 720,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#FBFBFB"
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 560,
        "height": 680,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#FBFBFB"
      },
      {
        "label": "capture-notice",
        "title": "toudou capture notice",
        "width": 360,
        "height": 72,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQjlFQ0E5MkNGQzg0NEMKUldSTWhQd3NxZXk1d2xYYkxNT0J4SzEvN0FSWFM4Q1RDNUlicy90WDhDam1sVDRUZEl3elUwMTAK",
      "endpoints": [
        "https://github.com/jakebodea/toudou/releases/latest/download/latest.json"
      ]
    }
  }
}
