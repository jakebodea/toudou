{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "towdow",
  "version": "0.1.0",
  "identifier": "dev.towdow.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "towdow",
        "width": 420,
        "height": 720,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#FBFBFB"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQjlFQ0E5MkNGQzg0NEMKUldSTWhQd3NxZXk1d2xYYkxNT0J4SzEvN0FSWFM4Q1RDNUlicy90WDhDam1sVDRUZEl3elUwMTAK",
      "endpoints": [
        "https://github.com/jakebodea/towdow/releases/latest/download/latest.json"
      ]
    }
  }
}
