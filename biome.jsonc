{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/react"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "!**/src-tauri",
      "!**/dist",
      "!**/.scratch",
      "!**/zig-out",
      "!**/.native",
      "!**/public/**/*.svg"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "complexity": {
        "noVoid": "off"
      }
    }
  }
}
